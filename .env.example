# ---------------------------------------------------------------------------
# Nexus Runtime - environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Required: API key for your LLM provider. Leave blank to run the server
# without an LLM (chat requests will fail with a clear 503 until a key
# is provided).
NEXUS_LLM_API_KEY=

# Model used for reasoning. Must exist on the endpoint you configure.
NEXUS_LLM_MODEL=gpt-4o-mini

# Optional: base URL of an OpenAI-compatible endpoint. Leave unset for the
# OpenAI default. Examples:
#   OpenRouter:  https://openrouter.ai/api/v1        (models like "vendor/name:free")
#   Groq:        https://api.groq.com/openai/v1
#   Ollama:      http://localhost:11434/v1           (local; key can be any string)
#   LM Studio:   http://localhost:1234/v1            (local)
# NEXUS_LLM_BASE_URL=

# Optional: JSON object of extra HTTP headers sent with every LLM request.
# Example (OpenRouter attribution):
#   NEXUS_LLM_EXTRA_HEADERS={"HTTP-Referer": "https://yourapp.example", "X-Title": "Nexus"}
# NEXUS_LLM_EXTRA_HEADERS=

# Legacy aliases (still honoured as fallbacks if the NEXUS_LLM_* values above
# are unset): OPENAI_API_KEY, OPENAI_MODEL, OPENAI_BASE_URL.

# ---------------------------------------------------------------------------
# Database (Part 2: persistent memory)
# ---------------------------------------------------------------------------

# Async SQLAlchemy URL for PostgreSQL with pgvector. The bundled
# docker-compose.yml maps the container's 5432 to host port 5433 (5432 is
# commonly taken). Local dev uses trust auth (no password committed anywhere).
# Matches: docker compose up -d
DATABASE_URL=postgresql+asyncpg://nexus@localhost:5433/nexus
# Production example (password comes from your own secrets, never the repo):
# DATABASE_URL=postgresql+asyncpg://nexus:${POSTGRES_PASSWORD}@db-host:5432/nexus

# Embedding provider: "openai" uses your NEXUS_LLM_API_KEY; "local" uses a
# deterministic hash-based embedding (dev/test only, no network, no cost).
# OpenAI-compatible endpoints that don't offer /embeddings should use "local"
# (Groq currently has no embeddings API).
NEXUS_EMBEDDING_PROVIDER=local

# Embedding model when using the "openai" provider. The vector column size is
# derived from this setting, so keep it consistent across migrations.
NEXUS_EMBEDDING_MODEL=text-embedding-3-small

# Embedding dimensions (default matches text-embedding-3-small). Only used by
# the "openai" provider; the local provider always uses 256 dims.
NEXUS_EMBEDDING_DIMENSIONS=1536

# How many memories to retrieve and inject into each chat turn's context.
NEXUS_MEMORY_TOP_K=5

# Skip memory extraction/embedding during tests or debugging.
NEXUS_MEMORY_ENABLED=true

# ---------------------------------------------------------------------------
# Web search (Phase D)
# ---------------------------------------------------------------------------
# Search provider: "duckduckgo" (keyless default) or "tavily" (needs a key).
NEXUS_SEARCH_PROVIDER=duckduckgo
# API key for the Tavily provider. Only needed when NEXUS_SEARCH_PROVIDER=tavily.
# NEXUS_TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# Identity (Part 3: cryptographic agent identity)
# ---------------------------------------------------------------------------

# Secret used to encrypt the agent's Ed25519 private key at rest (AES-GCM).
# Generate a secure value with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Never commit the real value. If an identity already exists and this secret
# is missing or wrong, Nexus startup fails with a clear error.
NEXUS_IDENTITY_KEY=

# Runtime environment: development | staging | production
NEXUS_ENV=development

# Server bind settings (used by run.py)
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8000

# Request timeout in seconds for a single LLM call
NEXUS_LLM_TIMEOUT=60

# Maximum number of messages kept per session (oldest are trimmed first)
NEXUS_MAX_SESSION_MESSAGES=100

# ---------------------------------------------------------------------------
# A2A (Part 6: agent-to-agent communication)
# ---------------------------------------------------------------------------

# Allow http(s)://localhost / loopback / private-range endpoints. Keep FALSE
# in production (SSRF protection); set TRUE only for local two-instance demos.
NEXUS_A2A_ALLOW_LOCAL_ENDPOINTS=false
# Reject inbound messages timestamped further than this into the future.
# Production deployments should synchronise clocks (NTP).
NEXUS_A2A_MAX_CLOCK_SKEW_SECONDS=30
# Signed messages expire after this many seconds.
NEXUS_A2A_MESSAGE_TTL_SECONDS=60
# Per-agent inbound request limit per minute.
NEXUS_A2A_RATE_LIMIT_PER_MINUTE=60
# Maximum inbound/outbound A2A message size in bytes.
NEXUS_A2A_MAX_MESSAGE_BYTES=65536
# Outbound HTTP timeout - a remote agent cannot hang the runtime.
NEXUS_A2A_TIMEOUT_SECONDS=10

# Log level: DEBUG | INFO | WARNING | ERROR
NEXUS_LOG_LEVEL=INFO
# Log format: json | text
#   json (default) - one JSON object per line, carrying `trace_id`. This is what
#                    a log aggregator can query, and what makes a request
#                    traceable across the API, the gateway and a peer agent.
#   text           - the human-readable format. Easier to read in a terminal
#                    while debugging; useless to a log index.
NEXUS_LOG_FORMAT=json
# Reported on every log line so a shared log index can tell deployments apart.
# Use a stable name (the service, not the host) - a hostname changes on redeploy
# and makes historical logs unsearchable.
NEXUS_SERVICE_NAME=nexus

# ---------------------------------------------------------------------------
# Authentication (M3)
# ---------------------------------------------------------------------------
# Secret used to SIGN SESSION COOKIES. Required whenever authentication is
# enforced. Keep it separate from NEXUS_IDENTITY_KEY so one leaked secret does
# not compromise both agent identity and session integrity.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
NEXUS_SESSION_KEY=

# Enforce authentication on the API. Unset => False in development, True in
# staging/production. Set explicitly to override either way.
# NEXUS_AUTH_REQUIRED=true

# Allow self-service account registration.
NEXUS_ALLOW_REGISTRATION=true

# Set the session cookie's Secure flag (HTTPS-only). Unset => True outside
# development. Must be false for a plain-HTTP local deployment.
# NEXUS_COOKIE_SECURE=false

# Session lifetime in seconds (default 14 days).
NEXUS_SESSION_TTL_SECONDS=1209600

# CORS: comma-separated browser origins allowed to call the API with
# credentials. NEVER "*" when credentials are in play. Defaults to the local
# frontend origins.
# NEXUS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# On the first registration, adopt the pre-auth single owner row so existing
# memory, conversations, identity and policies are not orphaned.
NEXUS_ADOPT_LEGACY_OWNER=true

# Optional OIDC (reserved; the password flow works without it).
# NEXUS_OIDC_ISSUER=
# NEXUS_OIDC_CLIENT_ID=
# NEXUS_OIDC_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Gateway Relay (Part 11: NAT traversal & relay)
# ---------------------------------------------------------------------------
# WebSocket URL of the hosted Nexus Gateway (e.g. wss://nexus-gateway-mv63.onrender.com/ws)
# When set, Nexus connects outbound to the gateway for cross-network A2A communication.
# NEXUS_GATEWAY_URL=wss://nexus-gateway-mv63.onrender.com/ws

# ---------------------------------------------------------------------------
# A2A protocol & transport (M6)
# ---------------------------------------------------------------------------
# Gateway-first egress (decision D2). When the Nexus Gateway is connected, all
# A2A traffic goes through it. Direct HTTP is opt-in because falling back
# silently would mean a peer's reachability decides your delivery semantics
# (no offline buffering, no delivery ack, different failure modes).
# NEXUS_A2A_DIRECT_EGRESS=false

# ---------------------------------------------------------------------------
# Natural-language orchestration (Part 12, decision D5) - OFF by default
# ---------------------------------------------------------------------------
# Orchestration converts free text into agent actions via an LLM intent
# resolver plus fuzzy target matching, so a wrong guess is acted upon and its
# failures are silent. Explicit asks and the workflow API work without it.
# NEXUS_ORCHESTRATION_ENABLED=false
# ---------------------------------------------------------------------------
# Durable jobs (M7)
# ---------------------------------------------------------------------------
# A PostgreSQL-backed queue (no broker). Work that must survive a restart,
# retry with backoff, or be idempotent goes through it.
NEXUS_JOB_POLL_INTERVAL_SECONDS=1
NEXUS_JOB_BATCH_SIZE=5
# How long a claimed job is leased to one worker. Also the upper bound on how
# long a crashed worker's job stays stuck before another worker retries it.
NEXUS_JOB_LEASE_SECONDS=300
# Per-job execution timeout: a hung handler must not hold the worker.
NEXUS_JOB_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------------------
# LLM resilience (M7)
# ---------------------------------------------------------------------------
# Attempts for a TRANSIENT provider failure (5xx, 429, connection error, empty
# response). A 4xx such as a malformed request is never retried, and neither is
# a rejected API key (retrying risks lockout).
NEXUS_LLM_MAX_ATTEMPTS=3
NEXUS_LLM_RETRY_BASE_SECONDS=0.5
# ---------------------------------------------------------------------------
# Memory & retention (M8)
# ---------------------------------------------------------------------------
# MANDATORY before the vector index can exist: pgvector cannot index a
# dimensionless vector column. Run scripts/build_vector_index.py once, which
# verifies your data, pins memories.embedding to the dimension below, and
# builds the HNSW index. Without it retrieval is an exact cosine scan (O(n)).
#
#   python scripts/build_vector_index.py --dry-run
#   python scripts/build_vector_index.py
#
# Retention for EPISODIC memories only (events age out). Semantic and
# relationship memories are durable facts about the owner and are never reaped.
# The reaper runs as a periodic system job on the job queue (see
# app/jobs/service.py) when retention is configured. Unset/0 disables
# retention entirely, so nothing is deleted by default.
# NEXUS_MEMORY_EPISODIC_RETENTION_DAYS=0